{
  "name": "graphviz-ts",
  "version": "1.0.0",
  "description": "A modern TypeScript graph visualization library - Graphviz clone that runs in browser and Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "graphviz-ts": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test dist/**/*.test.js",
    "cli": "node dist/cli.js",
    "eval": "npx ts-node eval/src/cli.ts run",
    "eval:quick": "npx ts-node eval/src/cli.ts quick",
    "eval:fix": "npx ts-node eval/src/cli.ts fix",
    "eval:list": "npx ts-node eval/src/cli.ts list"
  },
  "keywords": [
    "graphviz",
    "graph",
    "visualization",
    "dot",
    "diagram",
    "svg",
    "layout"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
